# Build with a private context containing this file, static `mebox`, and `web/dist`.
# AMS_BASE_IMAGE must identify the locally loaded, captured AMS runtime image.
ARG AMS_BASE_IMAGE
FROM ${AMS_BASE_IMAGE}
ARG AMS_BASE_IMAGE
ARG REVISION
ARG PERFORMANCE_TRACE=false
LABEL org.opencontainers.image.source="https://github.com/yunzaixi-dev/MeBox" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="${AMS_BASE_IMAGE}"
ENV MEBOX_PERFORMANCE_TRACE=${PERFORMANCE_TRACE}
COPY --chmod=755 mebox /usr/local/bin/mebox
COPY web/dist /app/web/dist
